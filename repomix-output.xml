        elseif ($_GET['type'] === 'main') {
            if (isset($_POST['deletePedido'])) {
                $result = $object->deletePedido((int) $_POST['idpedido']);
                header('Content-Type: application/json; charset=utf-8');
                echo json_encode($result);
