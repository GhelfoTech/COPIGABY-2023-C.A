                        echo json_encode($payload);
                        exit();
                    }
                    $_SESSION['pedido_flash'] = $payload;
                    header('Location: ?url=pedido');
                    exit();
                }

                $pago = [
                    'codigo_metodo' => (int) ($_POST['codigo_metodo'] ?? 0),
