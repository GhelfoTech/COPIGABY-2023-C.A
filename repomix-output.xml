    /**
     * Obtiene un IVA activo por su código.
     */
    public function getIvaByCodigo(int $codigoIva): ?array {
        if ($codigoIva <= 0) {
            return null;
        }

        try {
            $stmt = $this->conex->prepare(
                'SELECT codigo_IVA, porcentaje_iva, estado
                 FROM iva
                 WHERE codigo_IVA = ? AND estado = 1
                 LIMIT 1'
