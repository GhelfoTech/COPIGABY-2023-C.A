                        exit();
                    }
                    $_SESSION['pedido_flash'] = $payload;
                    header('Location: ?url=pedido');
                    exit();
                }

                $result = $object->updatePedido((int) $_POST['codigo_pedido'], [
                    'cedula_cliente'  => trim((string) $_POST['codigo_cliente']),
                    'estado'          => isset($_POST['estado']) ? (int) $_POST['estado'] : 1,
