/* Estilos de retroalimentación para validaciones frontend de CopiGabi. */
.cg-validation-error {
  display: block;
  width: 100%;
  margin-top: 0.35rem;
  color: #dc2626;
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.35;
}

.cg-field-invalid {
  border-color: #dc2626 !important;
  outline-color: #dc2626 !important;
  box-shadow: 0 0 0 1px rgba(220, 38, 38, 0.12) !important;
}


.cg-field-invalid:focus {
  border-color: #dc2626 !important;
  outline-color: #dc2626 !important;
}

@media (prefers-reduced-motion: no-preference) {
  .cg-validation-error {
    animation: cg-validation-appear 0.16s ease-out;
  }

  @keyframes cg-validation-appear {
    from { opacity: 0; transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }
}
