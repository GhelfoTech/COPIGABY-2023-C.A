            } else {
                $stmt = $this->conex->prepare(
                    'SELECT COUNT(*) FROM producto_insumo
                     WHERE nombre_producto = ? AND codigo_categoria = ?'
                );
                $stmt->execute([$nombre, $codigoCategoria]);
            }
            return (int) $stmt->fetchColumn() > 0;
        } catch (\PDOException $e) {
            return false;
        }
    }
}
