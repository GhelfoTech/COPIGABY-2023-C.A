                'nivel_cashea'    => (int) ($_POST['nivel_cashea'] ?? 0),
                'porcentaje_inicial' => $porcentajeInicial,
            ];

            $pago = [
                'codigo_metodo' => (int) ($_POST['codigo_metodo'] ?? 0),
